# Text files should use LF line endings
* text=auto eol=lf

# Explicitly declare text files
*.ts text
*.js text
*.json text
*.md text
*.yml text
*.yaml text

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

