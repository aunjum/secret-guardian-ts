    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.7",
    "simple-git": "^3.19.1"
  },
  "devDependencies": {
    "@types/node": "^20.6.2",
