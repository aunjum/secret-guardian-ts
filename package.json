{
  "name": "secret-guardian-ts",
  "version": "1.0.0",
  "description": "Plug-and-play pre-commit & pre-push secret scanner that blocks secrets (TypeScript compatible).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "secret-guardian": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "husky",
    "postinstall": "node ./dist/postinstall.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "git",
    "secrets",
    "pre-commit",
    "pre-push",
    "security",
    "secret-scanner",
    "git-hooks",
    "typescript",
    "security-tools",
    "secret-detection"
